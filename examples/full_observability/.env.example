# Copy to `.env` next to this file (git-ignored) and fill in.
# docker compose reads it automatically for the ${...} references in
# docker-compose.yml.

# One key per node: two nodes on one key spend one quota twice as fast while
# each counts half of it. With only one key per provider, delete the
# `-secondary` nodes from config.toml instead of reusing a key here.
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_API_KEY_2=your_second_helius_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_API_KEY_2=your_second_alchemy_api_key_here

GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here
